#cloud-config
# Ubuntu 26.04 LTS autoinstall for the NAVIS office device (INF-272): the base
# box from build-plan task 9 step 4. The NAVIS service itself comes after, from
# ops/navis-office/install.sh, which adds navis-office.service and kiosk.service.
#
# Before booting the OptiPlex:
#   BIOS: TPM 2.0 on (Security > TPM 2.0: On + Activate), Secure Boot on,
#         "AC power recovery" = Power On.
# Fill in every <...>:
#   <ADMIN_PASSWORD_HASH>  mkpasswd -m sha-512  (console login for the admin user)
#   <ADMIN_SSH_PUBKEY>     the key that may SSH in over the VPN
#   <WG_*>                 this device's WireGuard peer on the navegaid VPN (vps-ops skill)
# Boot: save this as `user-data` (plus an empty `meta-data`) on a USB stick
# labelled CIDATA and boot the 26.04 live-server installer next to it.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard: {layout: us}
  timezone: Asia/Jakarta
  # Full-disk encryption unlocked by the TPM, so the box boots unattended after
  # a power cut. Fails if TPM 2.0 or Secure Boot is off in the BIOS.
  # ponytail: fallback is {name: lvm, password: "..."}, typed at every boot.
  storage:
    layout:
      name: hybrid
      encrypted: true
  ssh:
    install-server: true
    allow-pw: false
  packages:
    - wireguard-tools
    - ufw
    - cage
    - python3-venv
    - alsa-utils
    - v4l-utils
  snaps:
    - name: chromium
  updates: security
  shutdown: reboot

  # Users live here instead of `identity` so `navis` can be created without sudo.
  user-data:
    hostname: navis-office
    users:
      - name: navegaid
        groups: [sudo]
        shell: /bin/bash
        lock_passwd: false
        passwd: "<ADMIN_PASSWORD_HASH>"
        ssh_authorized_keys:
          - "<ADMIN_SSH_PUBKEY>"
      - name: navis
        groups: [audio, video, render, input]
        shell: /bin/bash
        lock_passwd: true

    write_files:
      - path: /etc/wireguard/wg0.conf
        permissions: "0600"
        content: |
          [Interface]
          PrivateKey = <WG_PRIVATE_KEY>
          Address = <WG_ADDRESS>/32

          [Peer]
          PublicKey = <WG_SERVER_PUBLIC_KEY>
          Endpoint = <WG_ENDPOINT>:51820
          AllowedIPs = <WG_SERVER_VPN_IP>/32
          PersistentKeepalive = 25

    runcmd:
      - systemctl enable --now wg-quick@wg0
      # SSH only through the VPN. The kiosk talks to 127.0.0.1, which ufw leaves alone.
      - ufw default deny incoming
      - ufw default allow outgoing
      - ufw allow in on wg0 to any port 22 proto tcp
      - ufw --force enable
