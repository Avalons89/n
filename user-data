#cloud-config
# Ubuntu 26.04 LTS autoinstall for the NAVIS office device (INF-272): the base
# box from build-plan task 9 step 4. The NAVIS service itself comes after, from
# ops/navis-office/install.sh, which adds navis-office.service and kiosk.service.
#
# Before booting the OptiPlex:
#   BIOS: "AC power recovery" = Power On.
# Fill in every <...>:
#   <WG_*>                 this device's WireGuard peer on the navegaid VPN (vps-ops skill)
# Boot: save this as `user-data` (plus an empty `meta-data`) on a USB stick
# labelled CIDATA and boot the 26.04 live-server installer next to it.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard: {layout: us}
  timezone: Asia/Jakarta
  # TPM unlock failed (TPM still owned by the old Windows), so the disk screen
  # is left to the person installing: tick "Encrypt the LVM group with LUKS"
  # and type the passphrase there, which keeps it out of this public file.
  # It is typed at every boot, power cuts included.
  interactive-sections:
    - storage
  storage:
    layout:
      name: lvm
  ssh:
    install-server: true
    allow-pw: false
  packages:
    - wireguard-tools
    - ufw
    - cage
    - python3-venv
    - alsa-utils
    - v4l-utils
  snaps:
    - name: chromium
  updates: security
  shutdown: reboot

  # Users live here instead of `identity` so `navis` can be created without sudo.
  user-data:
    hostname: navis-office
    users:
      # Passwordless on purpose (asked for during setup): console autologin, no
      # password, sudo without one. SSH stays key-only. Set a password before
      # the device leaves Michael's desk.
      - name: navegaid
        groups: [sudo]
        shell: /bin/bash
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        ssh_authorized_keys:
          - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAURS3e6LywURf0pzvMBobiL6xFHSOywwbHBNdJ3FnBp claude-code@navis-office"
      - name: navis
        groups: [audio, video, render, input]
        shell: /bin/bash
        lock_passwd: true

    write_files:
      - path: /etc/systemd/system/getty@tty1.service.d/autologin.conf
        content: |
          [Service]
          ExecStart=
          ExecStart=-/sbin/agetty --autologin navegaid --noclear %I $TERM

      - path: /etc/wireguard/wg0.conf
        permissions: "0600"
        content: |
          [Interface]
          PrivateKey = <WG_PRIVATE_KEY>
          Address = <WG_ADDRESS>/32

          [Peer]
          PublicKey = <WG_SERVER_PUBLIC_KEY>
          Endpoint = <WG_ENDPOINT>:51820
          AllowedIPs = <WG_SERVER_VPN_IP>/32
          PersistentKeepalive = 25

    runcmd:
      - passwd -d navegaid
      - systemctl daemon-reload
      - systemctl restart getty@tty1
      - systemctl enable --now wg-quick@wg0
      # SSH only through the VPN. The kiosk talks to 127.0.0.1, which ufw leaves alone.
      - ufw default deny incoming
      - ufw default allow outgoing
      - ufw allow in on wg0 to any port 22 proto tcp
      - ufw --force enable
